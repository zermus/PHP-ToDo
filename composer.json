{
    "name": "cgee/php-todo",
    "description": "A simple self-hosted to-do list application with groups, checklists, and email reminders.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "phpmailer/phpmailer": "^7.0",
        "ezyang/htmlpurifier": "~4.19.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
